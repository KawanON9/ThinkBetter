<?xml version="1.0" encoding="utf-8"?>
<!-- Cores, textos e estilos da tela de Cadastro de Usuário -->
<resources>

    <!-- ===== Cores (identidade visual do app) ===== -->
    <color name="primary">#2A9D8F</color>
    <color name="primary_light">#3CC5AE</color>
    <color name="bg_screen">#F2FDFB</color>
    <color name="bg_input">#FFFFFF</color>
    <color name="border_soft">#C6EBE3</color>
    <color name="border_focus">#2A9D8F</color>
    <color name="text_title">#1E2D2B</color>
    <color name="text_accent">#3E8F82</color>
    <color name="text_label">#7FA8A0</color>
    <color name="text_muted">#8AA39E</color>
    <color name="text_hint">#A9BDB9</color>
    <color name="switch_track">#9FDCCF</color>
    <color name="btn_inativo_fundo">#D9EFEA</color>
    <color name="btn_inativo_texto">#7FA8A0</color>

    <!-- ===== Textos ===== -->
    <string name="cd_menu">Abrir menu</string>
    <string name="voltar">← Voltar</string>
    <string name="titulo_cadastro">Cadastro de Usuário</string>
    <string name="subtitulo_cadastro">Preencha seus dados para criar sua conta.</string>

    <string name="secao_dados_pessoais">DADOS PESSOAIS</string>
    <string name="secao_endereco">ENDEREÇO</string>

    <string name="label_nome">NOME</string>
    <string name="hint_nome">Ex: Maria</string>
    <string name="label_sobrenome">SOBRENOME</string>
    <string name="hint_sobrenome">Ex: Silva</string>
    <string name="label_cpf">CPF</string>
    <string name="hint_cpf">000.000.000-00</string>
    <string name="label_nascimento">NASCIMENTO</string>
    <string name="hint_nascimento">dd/mm/aaaa</string>
    <string name="label_email">ENDEREÇO DE E-MAIL</string>
    <string name="hint_email">Ex: maria@email.com</string>
    <string name="label_telefone">TELEFONE (COM DDD)</string>
    <string name="hint_telefone">(11) 9 0000-0000</string>

    <string name="label_cep">CEP</string>
    <string name="hint_cep">00000-000</string>
    <string name="label_endereco">RUA / AVENIDA</string>
    <string name="hint_endereco">Ex: Av. Paulista</string>
    <string name="label_numero">NÚMERO</string>
    <string name="hint_numero">Ex: 456</string>
    <string name="label_bairro">BAIRRO (OPCIONAL)</string>
    <string name="hint_bairro">Ex: Bela Vista</string>
    <string name="label_cidade">CIDADE</string>
    <string name="hint_cidade">Ex: São Paulo</string>
    <string name="label_uf">UF</string>
    <string name="hint_uf">SP</string>
    <string name="label_complemento">COMPLEMENTO (OPCIONAL)</string>
    <string name="hint_complemento">Apto, bloco, sala…</string>

    <!--Campo de senhas-->
    <string name="secao_senha">SENHA DE ACESSO</string>
    <string name="label_senha">SENHA</string>
    <string name="hint_senha">Mínimo de 8 caracteres</string>
    <string name="regra_senha">Crie sua senha com ao menos 8 caracteres.</string>
    <string name="label_confirmar_senha">CONFIRME SUA SENHA</string>
    <string name="hint_confirmar_senha">Digite a senha novamente</string>
    <string name="mostrar">Mostrar</string>
    <string name="ocultar">Ocultar</string>

    <string name="label_plano_saude">Plano de Saúde</string>
    <string name="desc_plano_saude">Ative se possuir convênio</string>
    <string name="label_plano">PLANO</string>

    <string name="label_carteirinha">Nº DA CARTEIRINHA</string>
    <string name="hint_carteirinha">Ex: 0000 0000 0000 0000</string>

    <string-array name="planos_saude">
        <item>Selecione o plano</item>
        <item>Amil</item>
        <item>Bradesco Saúde</item>
        <item>Prevent Senior</item>
        <item>Unimed</item>
    </string-array>

    <string name="btn_cadastrar">Cadastrar</string>

    <!-- ===== Estilos ===== -->
    <style name="CadastroSectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/text_accent</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <style name="CadastroFieldLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:textColor">@color/text_label</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="CadastroInput">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">46dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textColor">@color/text_title</item>
        <item name="android:textColorHint">@color/text_hint</item>
        <item name="android:textSize">14sp</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
