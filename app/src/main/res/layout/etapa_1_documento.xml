<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecione o paciente:"
        android:textColor="#557777"
        android:textSize="13sp"
        android:layout_marginBottom="12dp" />

    <!-- Mensagem de "carregando" / erro / lista vazia -->
    <TextView
        android:id="@+id/tvMensagemPacientesDoc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:text="Carregando pacientes..."
        android:textColor="#668888"
        android:textSize="13sp" />

    <!-- Pacientes do banco: preenchido pela EmissaoDocumentoActivity com item_paciente_documento.xml -->
    <LinearLayout
        android:id="@+id/containerPacientesDoc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

</LinearLayout>
