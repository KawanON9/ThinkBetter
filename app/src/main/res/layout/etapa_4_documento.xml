<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical">

    <!-- Caixa simulando a folha de Atestado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_white"
        android:orientation="vertical"
        android:padding="20dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Saúde Serviços de Psicologia"
            android:textColor="#222222"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:id="@+id/tvDocTitulo"
            android:text="ATESTADO"
            android:textColor="#222222"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvDocTexto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textIsSelectable="true"
            android:text="Atestamos para os devidos fins que o(a) paciente Carlos Mendes esteve sob nossos cuidados profissionais..."
            android:textColor="#444444"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Botões Editar e Confirmar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnEditarDoc"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="@android:color/transparent"
            android:text="Editar"
            android:textColor="#2E8B82"
            app:cornerRadius="10dp"
            app:strokeColor="#2E8B82"
            app:strokeWidth="1dp" />

        <Button
            android:id="@+id/btnConfirmarDoc"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#2E8B82"
            android:text="Confirmar"
            android:textColor="@android:color/white"
            app:cornerRadius="10dp" />
    </LinearLayout>

</LinearLayout>
