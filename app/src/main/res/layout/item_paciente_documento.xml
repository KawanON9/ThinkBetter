<?xml version="1.0" encoding="utf-8"?>
<!-- Um paciente na etapa 1 da Emissão de Documentos (mesmo visual do card que era fixo). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvIniciaisPacienteDoc"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_circle_teal"
        android:gravity="center"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="CM" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNomePacienteDoc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#222222"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Carlos Mendes" />

        <TextView
            android:id="@+id/tvPlanoPacienteDoc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#668888"
            android:textSize="12sp"
            tools:text="Particular" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="→"
        android:textColor="#2E8B82"
        android:textSize="18sp"
        android:textStyle="bold" />
</LinearLayout>
