<?xml version="1.0" encoding="utf-8"?>
<!-- Uma sessão da "Agenda de Hoje" (tela inicial do psicólogo).
     Mesmo visual dos itens que antes eram fixos no activity_main.xml. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_card_white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?android:attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvHoraSessao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#2E8B82"
        android:textStyle="bold"
        tools:text="14:00" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNomePacienteSessao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#222222"
            android:textStyle="bold"
            tools:text="Fernanda Lima" />

        <TextView
            android:id="@+id/tvDetalhesSessao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#777777"
            android:textSize="12sp"
            tools:text="Unimed · Avaliação · Online" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvStatusSessao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_tag_orange"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="#B85D10"
        android:textSize="11sp"
        tools:text="pendente" />
</LinearLayout>
