<?xml version="1.0" encoding="utf-8"?>
<!--
    Tela: Cadastro de Usuário
    Projeto: Gestão de Psicólogos
    Recursos usados: res/values/colors.xml, res/values/strings_cadastro.xml
                     res/drawable/bg_*.xml
    Dependência: androidx.appcompat (SwitchCompat)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_screen"
    android:importantForAutofill="noExcludeDescendants"
    android:orientation="vertical"
    tools:context=".ui.cadastro.CadastroUsuarioActivity"
    android:id="@+id/rootCadastro">

    <!-- ===== Barra superior (menu + avatar) ===== -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/white"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <ImageButton
            android:id="@+id/btnMenu"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_icon_circle"
            android:contentDescription="@string/cd_menu"
            android:padding="8dp"
            android:src="@android:drawable/ic_menu_sort_by_size"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/txtAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_avatar"
            android:gravity="center"
            android:text="DR"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_alignParentBottom="true"
            android:background="@color/border_soft" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- Voltar -->
            <TextView
                android:id="@+id/btnVoltar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                android:text="@string/voltar"
                android:textColor="@color/primary"
                android:textSize="13sp" />

            <!-- Título -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="serif"
                android:text="@string/titulo_cadastro"
                android:textColor="@color/text_title"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/subtitulo_cadastro"
                android:textColor="@color/text_accent"
                android:textSize="13sp" />

            <!-- ===== Card: Dados pessoais ===== -->
            <TextView
                style="@style/CadastroSectionLabel"
                android:text="@string/secao_dados_pessoais" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/CadastroFieldLabel"
                            android:layout_marginTop="0dp"
                            android:text="@string/label_nome" />

                        <EditText
                            android:id="@+id/edtNome"
                            style="@style/CadastroInput"
                            android:autofillHints="givenName"
                            android:hint="@string/hint_nome"
                            android:inputType="textCapWords|textNoSuggestions"
                            android:maxLength="16"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/CadastroFieldLabel"
                            android:layout_marginTop="0dp"
                            android:text="@string/label_sobrenome" />

                        <EditText
                            android:id="@+id/edtSobrenome"
                            style="@style/CadastroInput"
                            android:autofillHints="familyName"
                            android:hint="@string/hint_sobrenome"
                            android:inputType="textPersonName|textCapWords" />
                    </LinearLayout>
                </LinearLayout>

                <!-- CPF e Data de nascimento (obrigatórios na tabela Pacientes) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1.2"
                        android:orientation="vertical">

                        <TextView
                            style="@style/CadastroFieldLabel"
                            android:text="@string/label_cpf" />

                        <EditText
                            android:id="@+id/edtCpf"
                            style="@style/CadastroInput"
                            android:digits="0123456789.-"
                            android:hint="@string/hint_cpf"
                            android:inputType="number"
                            android:maxLength="14" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/CadastroFieldLabel"
                            android:text="@string/label_nascimento" />

                        <EditText
                            android:id="@+id/edtNascimento"
                            style="@style/CadastroInput"
                            android:digits="0123456789/"
                            android:hint="@string/hint_nascimento"
                            android:inputType="number"
                            android:maxLength="10" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/CadastroFieldLabel"
                    android:text="@string/label_email" />

                <EditText
                    android:id="@+id/edtEmail"
                    style="@style/CadastroInput"
                    android:autofillHints="emailAddress"
                    android:hint="@string/hint_email"
                    android:inputType="textEmailAddress" />

                <TextView
                    style="@style/CadastroFieldLabel"
                    android:text="@string/label_telefone" />

                <EditText
                    android:id="@+id/edtTelefone"
                    style="@style/CadastroInput"
                    android:autofillHints="phoneNumber"
                    android:hint="@string/hint_telefone"
                    android:inputType="phone"
                    android:maxLength="16" />
            </LinearLayout>

            <!-- ===== Card: Endereço ===== -->
            <TextView
                style="@style/CadastroSectionLabel"
                android:text="@string/secao_endereco" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    style="@style/CadastroFieldLabel"
                    android:layout_marginTop="0dp"
                    android:text="@string/label_cep" />

                <EditText
                    android:id="@+id/edtCep"
                    style="@style/CadastroInput"
                    android:autofillHints="postalCode"
                    android:hint="@string/hint_cep"
                    android:inputType="number"
                    android:maxLength="9" />

                <TextView
                    style="@style/CadastroFieldLabel"
                    android:text="@string/label_endereco" />

                <EditText
                    android:id="@+id/edtEndereco"
                    style="@style/CadastroInput"
                    android:autofillHints="postalAddress"
                    android:hint="@string/hint_endereco"
                    android:inputType="textPostalAddress|textCapWords|textNoSuggestions"
                    android:maxLength="120" />

                <!-- Número + Complemento -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="0.8"
                        android:orientation="vertical">

                        <TextView
                            style="@style/CadastroFieldLabel"
                            android:text="@string/label_numero" />

                        <EditText
                            android:id="@+id/edtNumero"
                            style="@style/CadastroInput"
                            android:hint="@string/hint_numero"
                            android:importantForAutofill="no"
                            android:inputType="textCapCharacters|textNoSuggestions"
                            android:maxLength="10" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1.2"
                        android:orientation="vertical">

                        <TextView
                            style="@style/CadastroFieldLabel"
                            android:text="@string/label_complemento" />

                        <EditText
                            android:id="@+id/edtComplemento"
                            style="@style/CadastroInput"
                            android:hint="@string/hint_complemento"
                            android:importantForAutofill="no"
                            android:inputType="textCapSentences|textNoSuggestions"
                            android:maxLength="80" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/CadastroFieldLabel"
                    android:text="@string/label_bairro" />

                <EditText
                    android:id="@+id/edtBairro"
                    style="@style/CadastroInput"
                    android:hint="@string/hint_bairro"
                    android:importantForAutofill="no"
                    android:inputType="textCapWords|textNoSuggestions"
                    android:maxLength="80" />

                <!-- Cidade + UF -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1.5"
                        android:orientation="vertical">

                        <TextView
                            style="@style/CadastroFieldLabel"
                            android:text="@string/label_cidade" />

                        <EditText
                            android:id="@+id/edtCidade"
                            style="@style/CadastroInput"
                            android:hint="@string/hint_cidade"
                            android:importantForAutofill="no"
                            android:inputType="textCapWords|textNoSuggestions"
                            android:maxLength="80" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="0.5"
                        android:orientation="vertical">

                        <TextView
                            style="@style/CadastroFieldLabel"
                            android:text="@string/label_uf" />

                        <EditText
                            android:id="@+id/edtUf"
                            style="@style/CadastroInput"
                            android:digits="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
                            android:hint="@string/hint_uf"
                            android:importantForAutofill="no"
                            android:inputType="textCapCharacters|textNoSuggestions"
                            android:maxLength="2" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== Card: Senha de acesso ===== -->
            <TextView
                style="@style/CadastroSectionLabel"
                android:text="@string/secao_senha" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Campo Senha -->
                <TextView
                    style="@style/CadastroFieldLabel"
                    android:layout_marginTop="0dp"
                    android:text="@string/label_senha" />

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/edtSenha"
                        style="@style/CadastroInput"
                        android:hint="@string/hint_senha"
                        android:inputType="textPassword"
                        android:paddingEnd="80dp" />

                    <TextView
                        android:id="@+id/btnMostrarSenha"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="end|center_vertical"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="14dp"
                        android:text="@string/mostrar"
                        android:textColor="@color/primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- Dica da regra -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/regra_senha"
                    android:textColor="@color/text_muted"
                    android:textSize="11sp" />

                <!-- Campo Confirme sua senha -->
                <TextView
                    style="@style/CadastroFieldLabel"
                    android:text="@string/label_confirmar_senha" />

                <EditText
                    android:id="@+id/edtConfirmarSenha"
                    style="@style/CadastroInput"
                    android:hint="@string/hint_confirmar_senha"
                    android:inputType="textPassword" />
            </LinearLayout>

            <!-- ===== Card: Plano de Saúde (flag) ===== -->
            <LinearLayout
                android:id="@+id/cardPlanoSaude"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:animateLayoutChanges="true"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="14dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_plano_saude"
                            android:textColor="@color/text_title"
                            android:textSize="14sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/desc_plano_saude"
                            android:textColor="@color/text_accent"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchPlanoSaude"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        android:contentDescription="@string/label_plano_saude"
                        app:thumbTint="@color/white"
                        app:trackTint="@color/switch_track" />
                </LinearLayout>

                <!-- Campo exibido somente quando o switch está ativado -->
                <LinearLayout
                    android:id="@+id/containerPlanoSaude"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="8dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <!-- Menu de seleção do plano -->
                    <TextView
                        style="@style/CadastroFieldLabel"
                        android:layout_marginTop="4dp"
                        android:text="@string/label_plano" />

                    <Spinner
                        android:id="@+id/spinnerPlanoSaude"
                        android:layout_width="match_parent"
                        android:layout_height="46dp"
                        android:background="@drawable/bg_spinner"
                        android:entries="@array/planos_saude"
                        android:popupBackground="@drawable/bg_card"
                        android:spinnerMode="dropdown" />

                    <!-- Número da carteirinha -->
                    <TextView
                        style="@style/CadastroFieldLabel"
                        android:text="@string/label_carteirinha" />

                    <EditText
                        android:id="@+id/edtCarteirinha"
                        style="@style/CadastroInput"
                        android:digits="0123456789 "
                        android:hint="@string/hint_carteirinha"
                        android:importantForAutofill="no"
                        android:inputType="number"
                        android:maxLength="25" />
                </LinearLayout>
            </LinearLayout>

            <!-- Botão principal -->
            <!-- Botão principal -->
            <Button
                android:id="@+id/btnCadastrar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_button_cadastrar"
                android:stateListAnimator="@null"
                android:text="@string/btn_cadastrar"
                android:textAllCaps="false"
                android:textColor="@color/txt_button_cadastrar"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
