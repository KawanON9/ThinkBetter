<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_tag_teal_light"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvIniciaisProfissional"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_teal"
            android:gravity="center"
            android:text="AS"
            android:textColor="@android:color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNomeProfissional"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Dra. Ana Souza"
                android:textColor="#222222"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDataHoraAtendimento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ter, 27 de out · 10:00"
                android:textColor="#668888"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvModalidadeAtendimento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_teal_light"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="♦ Online"
                    android:textColor="#0D5C52"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvStatusAtendimento"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_tag_orange"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="Pendente"
                    android:textColor="#B85D10"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Botão Iniciar (Aparece APENAS se for Online) -->
    <Button
        android:id="@+id/btnIniciarChamada"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#2E8B82"
        android:text="Iniciar Chamada (Google Meet)"
        android:textAllCaps="false"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:visibility="gone"
        app:cornerRadius="8dp" />

    <!-- Botões de Ação: Confirmar e Cancelar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <Button
            android:id="@+id/btnConfirmarPresenca"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:backgroundTint="#2E8B82"
            android:text="Confirmar"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="12sp"
            app:cornerRadius="8dp" />

        <Button
            android:id="@+id/btnCancelarConsultaPaciente"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:backgroundTint="@android:color/transparent"
            android:text="Cancelar"
            android:textAllCaps="false"
            android:textColor="#E53E3E"
            android:textSize="12sp"
            app:cornerRadius="8dp"
            app:strokeColor="#FEB2B2"
            app:strokeWidth="1dp" />
    </LinearLayout>
</LinearLayout>
