<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Horário e Data em Destaque -->
    <LinearLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_circle_white_border"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHoraAtendimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14:00"
            android:textColor="#2E8B82"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDataAtendimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01/11"
            android:textColor="#668888"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Informações do Atendimento -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNomePacienteAtendimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fernanda Lima"
            android:textColor="#222222"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetalhesAtendimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Avaliação · Unimed"
            android:textColor="#668888"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Status e Ações -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvStatusAtendimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag_orange"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="pendente"
            android:textColor="#B85D10"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Botão usado na Agenda para Indisponibilizar -->
        <Button
            android:id="@+id/btnIndisponibilizar"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="@android:color/transparent"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="6dp"
            android:text="Indisponibilizar"
            android:textAllCaps="false"
            android:textColor="#E53E3E"
            android:textSize="10sp"
            android:visibility="gone" />

        <!-- Botão usado na Tela de Atendimentos para Iniciar a chamada -->
        <Button
            android:id="@+id/btnIniciarAtendimento"
            android:layout_width="wrap_content"
            android:layout_height="30dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#2E8B82"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="10dp"
            android:text="Iniciar"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>