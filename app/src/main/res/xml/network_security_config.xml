<?xml version="1.0" encoding="utf-8"?>
<!--
    Prova de conceito: libera HTTP (sem HTTPS) SÓ para o notebook da rede local.
    • 192.168.0.10 → troque pelo IP do notebook (o mesmo do ApiClient.BASE_URL)
    • 10.0.2.2     → endereço do notebook visto de dentro do emulador
    Para qualquer outro endereço, o Android continua exigindo HTTPS.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">192.168.0.10</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
