<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PerfilActivity">

    <!-- Conteúdo Principal com ScrollView -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F4FBFB"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <!-- Topo: Menu e Avatar -->
            <ImageButton
                android:id="@+id/btnMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_white_border"
                android:contentDescription="Abrir Menu"
                android:src="@android:drawable/ic_menu_sort_by_size"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="#2E8B82" />

            <TextView
                android:id="@+id/tvAvatarTop"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_circle_teal"
                android:gravity="center"
                android:text="DR"
                android:textColor="@android:color/white"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Botão Voltar -->
            <TextView
                android:id="@+id/btnVoltar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:clickable="true"
                android:focusable="true"
                android:text="← Voltar"
                android:textColor="#2E8B82"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnMenu" />

            <!-- Título e Subtítulo -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Meu Perfil"
                android:textColor="#112222"
                android:textSize="26sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnVoltar" />

            <TextView
                android:id="@+id/tvSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Suas informações pessoais e de contato"
                android:textColor="#557777"
                android:textSize="13sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvTitle" />

            <!-- Seção da Foto de Perfil -->
            <LinearLayout
                android:id="@+id/layoutFoto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/tvSubtitle">

                <TextView
                    android:id="@+id/tvAvatarPerfil"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_circle_teal"
                    android:gravity="center"
                    android:text="DR"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnAlterarFoto"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="16dp"
                    android:backgroundTint="@android:color/transparent"
                    android:text="Alterar foto"
                    android:textAllCaps="false"
                    android:textColor="#2E8B82"
                    android:textSize="13sp"
                    app:cornerRadius="20dp"
                    app:strokeColor="#2E8B82"
                    app:strokeWidth="1dp" />
            </LinearLayout>

            <!-- Campo: Nome Completo -->
            <TextView
                android:id="@+id/lblNome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Nome completo"
                android:textColor="#557777"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutFoto" />

            <EditText
                android:id="@+id/etNome"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_rounded_input"
                android:hint="Dr. Rafael Costa"
                android:inputType="textPersonName"
                android:paddingHorizontal="16dp"
                android:textColor="#222222"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/lblNome" />

            <!-- Campo: E-mail -->
            <TextView
                android:id="@+id/lblEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="E-mail"
                android:textColor="#557777"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etNome" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_rounded_input"
                android:hint="rafael@gmail.com.br"
                android:inputType="textEmailAddress"
                android:paddingHorizontal="16dp"
                android:textColor="#222222"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/lblEmail" />

            <!-- Campo: Telefone -->
            <TextView
                android:id="@+id/lblTelefone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Telefone"
                android:textColor="#557777"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etEmail" />

            <EditText
                android:id="@+id/etTelefone"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_rounded_input"
                android:hint="(11) 9 9000-0000"
                android:inputType="phone"
                android:paddingHorizontal="16dp"
                android:textColor="#222222"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/lblTelefone" />

            <!-- Campo: CRP + Tag Verificado -->
            <TextView
                android:id="@+id/lblCrp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="CRP"
                android:textColor="#557777"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etTelefone" />

            <FrameLayout
                android:id="@+id/layoutCrp"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                app:layout_constraintTop_toBottomOf="@id/lblCrp">

                <EditText
                    android:id="@+id/etCrp"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_rounded_input"
                    android:hint="06/67890"
                    android:inputType="text"
                    android:paddingStart="16dp"
                    android:paddingEnd="100dp"
                    android:textColor="#222222"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvVerificado"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_tag_green"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Verificado"
                    android:textColor="#1E7E4A"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <!-- Campo: Especialidade / Abordagem -->
            <TextView
                android:id="@+id/lblEspecialidade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Especialidade / Abordagem"
                android:textColor="#557777"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layoutCrp" />

            <EditText
                android:id="@+id/etEspecialidade"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_rounded_input"
                android:hint="Terapia Cognitivo-Comportamental"
                android:inputType="text"
                android:paddingHorizontal="16dp"
                android:textColor="#222222"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/lblEspecialidade" />

            <!-- Campo: Contato de emergência -->
            <TextView
                android:id="@+id/lblEmergencia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Contato de emergência"
                android:textColor="#557777"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etEspecialidade" />

            <EditText
                android:id="@+id/etEmergencia"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_rounded_input"
                android:hint="Nome – (11) 9 0000-0000"
                android:inputType="text"
                android:paddingHorizontal="16dp"
                android:textColor="#222222"
                android:textSize="14sp"
                app:layout_constraintTop_toBottomOf="@id/lblEmergencia" />

            <!-- Botão Salvar alterações -->
            <Button
                android:id="@+id/btnSalvar"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="#2E8B82"
                android:text="Salvar alterações"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                app:cornerRadius="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etEmergencia" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>

    <!-- Componente do Menu Lateral (Navigation Drawer) -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#0D5C52"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="#FFFFFF"
        app:itemTextColor="#FFFFFF"
        app:menu="@menu/drawer_menu" />

</androidx.drawerlayout.widget.DrawerLayout>