<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Ícone PDF -->
    <TextView
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/bg_circle_white_border"
        android:gravity="center"
        android:text="PDF"
        android:textColor="#2E8B82"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Título do Documento e Profissional/Data -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTituloDocumento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recibo de consulta"
            android:textColor="#222222"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetalhesDocumento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Dra. Ana Souza · 20/10/2026"
            android:textColor="#668888"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Botão Baixar -->
    <Button
        android:id="@+id/btnBaixar"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:backgroundTint="@android:color/transparent"
        android:paddingHorizontal="14dp"
        android:text="Baixar"
        android:textAllCaps="false"
        android:textColor="#2E8B82"
        android:textSize="12sp"
        app:cornerRadius="18dp"
        app:strokeColor="#2E8B82"
        app:strokeWidth="1dp" />
</LinearLayout>