<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <!-- Ícone de Usuário Arredondado -->
    <TextView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_circle_white_border"
        android:gravity="center"
        android:text="👤"
        android:textSize="18sp" />

    <!-- Informações do Paciente -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNomePaciente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Carlos Mendes"
            android:textColor="#222222"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDetalhesPaciente"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Particular · (11) 9 9000-0002"
            android:textColor="#668888"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Seta para a Direita -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="→"
        android:textColor="#2E8B82"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>